/-! Auxiliary lemmas used by the development (formerly `Solution.lean`). They do not
assert `MainClaim`; the final statement is proved in `Solution.lean`. -/

namespace Whitehead

open scoped unitInterval Topology

theorem killsPi2_comp {X Y Z : Type} [TopologicalSpace X] [TopologicalSpace Y]
    [TopologicalSpace Z] (f : C(X, Y)) (g : C(Y, Z)) (h : KillsPi2 f) :
    KillsPi2 (g.comp f) := by
  intro x p
  have hp := mapSquare_homotopic g (h x p)
  rw [mapSquare_const] at hp
  exact hp

theorem acyclic_homeomorph_iff {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
    (e : X ≃ₜ Y) : Acyclic X ↔ Acyclic Y := by
  constructor
  · intro h n hn
    exact (((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{0} ℤ) n).obj
      (ModuleCat.of ℤ ℤ)).mapIso (TopCat.isoOfHomeo e)).isZero_iff.mp (h n hn)
  · intro h n hn
    exact (((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{0} ℤ) n).obj
      (ModuleCat.of ℤ ℤ)).mapIso (TopCat.isoOfHomeo e)).isZero_iff.mpr (h n hn)

theorem isCoveringMap_identity (X : Type) [TopologicalSpace X] :
    IsCoveringMap (id : X → X) := by
  intro x
  have h : IsEvenlyCovered (id : X → X) x PUnit.{1} := by
    refine ⟨inferInstance, Set.univ, Set.mem_univ _, isOpen_univ, isOpen_univ, ?_, ?_⟩
    · exact (Homeomorph.prodUnique (Set.univ : Set X) PUnit.{1}).symm
    · intro z
      rfl
  exact h.to_isEvenlyCovered_preimage

/-- Every acyclic connected CW complex has the required cover, namely its identity cover. -/
theorem hasAcyclicRegularCover_of_acyclic (K : TwoComplex) (h : Acyclic K) :
    HasAcyclicRegularCover K := by
  refine ⟨K, inferInstance, ContinuousMap.id K, isCoveringMap_identity K,
    Function.surjective_id, inferInstance, ?_, h⟩
  intro d e he
  refine ⟨Homeomorph.refl K, fun _ => rfl, ?_⟩
  exact he

theorem hasChain_forget_finite {K : TwoComplex} {n : ℕ} (h : HasChain K n true) :
    HasChain K n false := by
  obtain ⟨L, C, e, he, _, hconn, hsteps⟩ := h
  exact ⟨L, C, e, he, by simp, hconn, hsteps⟩

/-- A longer strict chain gives a shorter one by retaining its initial subcomplexes. -/
theorem hasChain_prefix {K : TwoComplex} {m n : ℕ} {finite : Bool}
    (hmn : m ≤ n) (h : HasChain K n finite) : HasChain K m finite := by
  obtain ⟨L, C, e, he, hf, hconn, hsteps⟩ := h
  let idx : Fin (m + 1) → Fin (n + 1) := fun i => ⟨i.val, Nat.lt_of_lt_of_le i.isLt
    (Nat.add_le_add_right hmn 1)⟩
  refine ⟨L, C ∘ idx, e, he, hf, fun i => hconn (idx i), ?_⟩
  intro i
  exact hsteps ⟨i.val, Nat.lt_of_lt_of_le i.isLt hmn⟩

theorem killsPi2_of_subsingleton {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
    (f : C(X, Y)) (h : ∀ x : X, Subsingleton (HomotopyGroup (Fin 2) X x)) :
    KillsPi2 f := by
  intro x p
  have he : (Quotient.mk _ p : HomotopyGroup (Fin 2) X x) =
      Quotient.mk _ GenLoop.const := @Subsingleton.elim _ (h x) _ _
  have hh := Quotient.exact he
  have hm := mapSquare_homotopic f hh
  rwa [mapSquare_const] at hm

/-- Homeomorphisms are genuine covering maps, with singleton fibers. -/
theorem isCoveringMap_homeomorph {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
    (e : X ≃ₜ Y) : IsCoveringMap e :=
  (isCoveringMap_identity Y).comp_homeomorph e

/-- The pi2-killing condition is unchanged by transporting a commuting square
through homeomorphisms. -/
theorem killsPi2_homeomorph_square_iff {X Y X' Y' : Type}
    [TopologicalSpace X] [TopologicalSpace Y]
    [TopologicalSpace X'] [TopologicalSpace Y']
    (e : X ≃ₜ X') (d : Y ≃ₜ Y') (f : C(X, Y)) (g : C(X', Y'))
    (h : g.comp ⟨e, e.continuous⟩ = (⟨d, d.continuous⟩ : C(Y, Y')).comp f) :
    KillsPi2 g ↔ KillsPi2 f := by
  rw [← killsPi2_covering_precomp_iff ⟨e, e.continuous⟩
    (isCoveringMap_homeomorph e) e.surjective g]
  rw [h]
  exact killsPi2_covering_postcomp_iff f ⟨d, d.continuous⟩ (isCoveringMap_homeomorph d)

/-- For supported CW subcomplexes, killing pi2 is exactly the same condition
as for the actual induced-subposet realization map. -/
theorem killsPi2_orderNerve_subcomplex_inclusion_iff {P : Type} [PartialOrder P]
    {A B : Set P} (h : A ⊆ B) :
    KillsPi2 (⟨Set.inclusion (FiniteChains.Comb.orderNerveRealizationSubcomplex_mono h),
      continuous_inclusion (FiniteChains.Comb.orderNerveRealizationSubcomplex_mono h)⟩ :
      C((FiniteChains.Comb.orderNerveRealizationSubcomplex P A :
          Set (FiniteChains.Comb.orderNerveRealization P)),
        (FiniteChains.Comb.orderNerveRealizationSubcomplex P B :
          Set (FiniteChains.Comb.orderNerveRealization P)))) ↔
      KillsPi2 ⟨FiniteChains.Comb.orderNerveRealizationMap (Set.inclusion h)
        (fun _ _ h => h),
        (FiniteChains.Comb.orderNerveRealizationMap (Set.inclusion h)
          (fun _ _ h => h)).hom.continuous⟩ :=
  killsPi2_homeomorph_square_iff
    (FiniteChains.Comb.orderNerveRealizationSubtypeHomeomorph A)
    (FiniteChains.Comb.orderNerveRealizationSubtypeHomeomorph B) _ _
    (FiniteChains.Comb.orderNerveRealizationSubtypeHomeomorph_inclusion_continuousMap h)

end Whitehead
