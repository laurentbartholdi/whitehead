theorem tab_xinv (hr : x * x * y * x⁻¹ * y = 1 ∧ x * y * y * y * y * x * y⁻¹ = 1) (i : Fin 120) :
    Wv x y i * x⁻¹ = Wv x y (txinv i) := by
  have h := tab_x hr (txinv i)
  rw [txv_txinv] at h
  rw [← h]
  group

theorem tab_yinv (hr : x * x * y * x⁻¹ * y = 1 ∧ x * y * y * y * y * x * y⁻¹ = 1) (i : Fin 120) :
    Wv x y i * y⁻¹ = Wv x y (tyinv i) := by
  have h := tab_y hr (tyinv i)
  rw [tyv_tyinv] at h
  rw [← h]
  group

/-- **The coset enumeration closes.**  In any group generated by two elements satisfying the
two relators of `A`, the 120 words of the table exhaust the group. -/
theorem surjective_Wv (hr : x * x * y * x⁻¹ * y = 1 ∧ x * y * y * y * y * x * y⁻¹ = 1)
    (hgen : Subgroup.closure ({x, y} : Set G) = ⊤) : Function.Surjective (Wv x y) := by
  have key : ∀ g ∈ Subgroup.closure ({x, y} : Set G),
      (∀ i, ∃ j, Wv x y i * g = Wv x y j) ∧ (∀ i, ∃ j, Wv x y i * g⁻¹ = Wv x y j) := by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem z hz =>
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with rfl | rfl
        · exact ⟨fun i => ⟨txv i, tab_x hr i⟩, fun i => ⟨txinv i, tab_xinv hr i⟩⟩
        · exact ⟨fun i => ⟨tyv i, tab_y hr i⟩, fun i => ⟨tyinv i, tab_yinv hr i⟩⟩
    | one => exact ⟨fun i => ⟨i, mul_one _⟩, fun i => ⟨i, by simp⟩⟩
    | mul a b _ _ iha ihb =>
        refine ⟨fun i => ?_, fun i => ?_⟩
        · obtain ⟨j, hj⟩ := iha.1 i
          obtain ⟨k, hk⟩ := ihb.1 j
          exact ⟨k, by rw [← mul_assoc, hj, hk]⟩
        · obtain ⟨j, hj⟩ := ihb.2 i
          obtain ⟨k, hk⟩ := iha.2 j
          exact ⟨k, by rw [_root_.mul_inv_rev, ← mul_assoc, hj, hk]⟩
    | inv a _ iha =>
        refine ⟨iha.2, fun i => ?_⟩
        obtain ⟨j, hj⟩ := iha.1 i
        exact ⟨j, by rwa [inv_inv]⟩
  intro g
  obtain ⟨j, hj⟩ := (key g (by rw [hgen]; exact Subgroup.mem_top g)).1 0
  exact ⟨j, by rw [← hj, Wv_zero, one_mul]⟩

/-- Every group generated by two elements satisfying the relators of `A` has at most `120`
elements. -/
theorem card_le_120 (hr : x * x * y * x⁻¹ * y = 1 ∧ x * y * y * y * y * x * y⁻¹ = 1)
    (hgen : Subgroup.closure ({x, y} : Set G) = ⊤) : Nat.card G ≤ 120 := by
  have h := Nat.card_le_card_of_surjective _ (surjective_Wv hr hgen)
  simpa using h

/-!
## The presented group of `A` and the isomorphism with `SL(2,5)`
-/

/-- The group `SL(2,5)`. -/
abbrev SL25 := Matrix.SpecialLinearGroup (Fin 2) (ZMod 5)

instance : DecidableEq SL25 := fun a b =>
  decidable_of_iff _ (Matrix.SpecialLinearGroup.ext_iff a b).symm

/-- The matrix chosen as the image of the first generator. -/
def XM : SL25 := ⟨!![0, 1; 4, 1], by decide⟩

/-- The matrix chosen as the image of the second generator. -/
def YM : SL25 := ⟨!![0, 2; 2, 3], by decide⟩

theorem hrM : XM * XM * YM * XM⁻¹ * YM = 1 ∧ XM * YM * YM * YM * YM * XM * YM⁻¹ = 1 := by
  constructor <;> decide

/-- The 120 matrices that the coset words take as values. -/
