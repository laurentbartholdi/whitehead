theorem Wv_XM_YM (i : Fin 120) : Wv XM YM i = matv i := by fin_cases i <;> decide

theorem matv_injective : Function.Injective matv := by decide

/-!
### The presented group `G(A)`
-/

/-- The first relator `x²yx⁻¹y` of `A`. -/
def rel1 : FreeGroup (Fin 2) :=
  FreeGroup.of 0 * FreeGroup.of 0 * FreeGroup.of 1 * (FreeGroup.of 0)⁻¹ * FreeGroup.of 1

/-- The second relator `xy⁴xy⁻¹` of `A`. -/
def rel2 : FreeGroup (Fin 2) :=
  FreeGroup.of 0 * FreeGroup.of 1 * FreeGroup.of 1 * FreeGroup.of 1 * FreeGroup.of 1 *
    FreeGroup.of 0 * (FreeGroup.of 1)⁻¹

/-- The relators of the presentation `A = ⟨x, y | x²yx⁻¹y, xy⁴xy⁻¹⟩`. -/
def relsA : Set (FreeGroup (Fin 2)) := {rel1, rel2}

/-- The group `G(A)` of the presentation `A`. -/
abbrev GA := PresentedGroup relsA

/-- The generator `x` of `G(A)`. -/
def xA : GA := PresentedGroup.of 0

/-- The generator `y` of `G(A)`. -/
def yA : GA := PresentedGroup.of 1

theorem hrA : xA * xA * yA * xA⁻¹ * yA = 1 ∧ xA * yA * yA * yA * yA * xA * yA⁻¹ = 1 := by
  constructor
  · have h : PresentedGroup.mk relsA rel1 = 1 :=
      PresentedGroup.one_of_mem (Or.inl rfl)
    simpa [rel1, xA, yA, PresentedGroup.of, map_mul, map_inv] using h
  · have h : PresentedGroup.mk relsA rel2 = 1 :=
      PresentedGroup.one_of_mem (Or.inr rfl)
    simpa [rel2, xA, yA, PresentedGroup.of, map_mul, map_inv] using h

theorem range_of_eq : Set.range (PresentedGroup.of : Fin 2 → GA) = {xA, yA} := by
  ext z
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

theorem hgenA : Subgroup.closure ({xA, yA} : Set GA) = ⊤ := by
  rw [← range_of_eq]
  exact PresentedGroup.closure_range_of relsA

theorem liftM_rels : ∀ r ∈ relsA, FreeGroup.lift ![XM, YM] r = 1 := by
  rintro r (rfl | rfl)
  · simp only [rel1, map_mul, map_inv, FreeGroup.lift_apply_of, Matrix.cons_val_zero,
      Matrix.cons_val_one]
    exact hrM.1
  · simp only [rel2, map_mul, map_inv, FreeGroup.lift_apply_of, Matrix.cons_val_zero,
      Matrix.cons_val_one]
    exact hrM.2

/-- The homomorphism `G(A) → SL(2,5)` sending the generators to `XM` and `YM`. -/
def phi : GA →* SL25 := PresentedGroup.toGroup liftM_rels

theorem phi_xA : phi xA = XM := PresentedGroup.toGroup.of liftM_rels

theorem phi_yA : phi yA = YM := PresentedGroup.toGroup.of liftM_rels

theorem phi_Wv (i : Fin 120) : phi (Wv xA yA i) = Wv XM YM i := by
  rw [map_Wv, phi_xA, phi_yA]

theorem card_SL25 : Fintype.card SL25 = 120 := by decide

theorem matv_bijective : Function.Bijective matv := by
  refine (Fintype.bijective_iff_injective_and_card matv).mpr ⟨matv_injective, ?_⟩
  simp [card_SL25]

theorem phi_surjective : Function.Surjective phi := by
  intro M
  obtain ⟨i, hi⟩ := matv_bijective.2 M
  exact ⟨Wv xA yA i, by rw [phi_Wv, Wv_XM_YM, hi]⟩

theorem phi_injective : Function.Injective phi := by
  intro a b hab
  obtain ⟨i, rfl⟩ := surjective_Wv hrA hgenA a
  obtain ⟨j, rfl⟩ := surjective_Wv hrA hgenA b
  rw [phi_Wv, phi_Wv, Wv_XM_YM, Wv_XM_YM] at hab
  rw [matv_injective hab]

/-- **Remark 2: `G(A) ≅ SL(2,5)`.**  The group of the presentation
`A = ⟨x, y | x²yx⁻¹y, xy⁴xy⁻¹⟩` is isomorphic to `SL(2,5)`, by the homomorphism sending the
two generators to the matrices `XM` and `YM`. -/
noncomputable def presentedA_mulEquiv_SL25 : GA ≃* SL25 :=
  MulEquiv.ofBijective phi ⟨phi_injective, phi_surjective⟩

/-- `G(A)` is finite of order `120`. -/
theorem card_GA : Nat.card GA = 120 := by
  have : Nat.card GA = Nat.card SL25 := Nat.card_congr presentedA_mulEquiv_SL25.toEquiv
  rw [this, Nat.card_eq_fintype_card, card_SL25]

/-- The matrix `XM` has order `6` in `SL(2,5)`. -/
theorem orderOf_XM : orderOf XM = 6 := by
  refine orderOf_eq_of_pow_and_pow_div_prime (by norm_num) (by decide) ?_
  intro p hp hdvd
  have hmem : p ∈ Nat.divisors 6 := Nat.mem_divisors.mpr ⟨hdvd, by norm_num⟩
  fin_cases hmem
  · exact absurd hp (by norm_num)
  · decide
  · decide
  · exact absurd hp (by norm_num)

/-- **`G(A)` has torsion**: the generator `x` has order `6`.  This is the property of the
example used in Remark 2 to see that `K(A)`, which is acyclic, is not aspherical. -/
theorem orderOf_xA : orderOf xA = 6 := by
  have h : orderOf xA = orderOf (phi xA) := (orderOf_injective phi phi_injective xA).symm
  rw [h, phi_xA, orderOf_XM]

end ExampleA
