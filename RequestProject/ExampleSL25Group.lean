  · show f (x⁻¹ * y * y * x⁻¹ * y⁻¹ * x⁻¹) = (f x)⁻¹ * f y * f y * (f x)⁻¹ * (f y)⁻¹ * (f x)⁻¹
    simp
  · show f (x⁻¹ * y⁻¹ * x⁻¹ * y * y * x) = (f x)⁻¹ * (f y)⁻¹ * (f x)⁻¹ * f y * f y * f x
    simp
  · show f (x⁻¹ * y⁻¹ * y⁻¹ * x⁻¹ * y⁻¹ * y⁻¹) = (f x)⁻¹ * (f y)⁻¹ * (f y)⁻¹ * (f x)⁻¹ * (f y)⁻¹ * (f y)⁻¹
    simp
  · show f (y⁻¹ * x⁻¹ * y⁻¹ * y⁻¹ * x⁻¹ * y⁻¹) = (f y)⁻¹ * (f x)⁻¹ * (f y)⁻¹ * (f y)⁻¹ * (f x)⁻¹ * (f y)⁻¹
    simp
  · show f (y⁻¹ * y⁻¹ * x * y * x * y) = (f y)⁻¹ * (f y)⁻¹ * f x * f y * f x * f y
    simp
  · show f (x * y * x * y * y * x * y) = f x * f y * f x * f y * f y * f x * f y
    simp
  · show f (x * y * x * y⁻¹ * y⁻¹ * x⁻¹ * y⁻¹) = f x * f y * f x * (f y)⁻¹ * (f y)⁻¹ * (f x)⁻¹ * (f y)⁻¹
    simp
  · show f (x * y * y * x * y * y * x⁻¹) = f x * f y * f y * f x * f y * f y * (f x)⁻¹
    simp
  · show f (x * y⁻¹ * y⁻¹ * x * y * x * y) = f x * (f y)⁻¹ * (f y)⁻¹ * f x * f y * f x * f y
    simp
  · show f (y * x * y * y * x * y * y) = f y * f x * f y * f y * f x * f y * f y
    simp
  · show f (y * x * y⁻¹ * y⁻¹ * x⁻¹ * y⁻¹ * y⁻¹) = f y * f x * (f y)⁻¹ * (f y)⁻¹ * (f x)⁻¹ * (f y)⁻¹ * (f y)⁻¹
    simp
  · show f (y * y * x * y * y * x * y) = f y * f y * f x * f y * f y * f x * f y
    simp
  · show f (x⁻¹ * y * y * x * y * y * x) = (f x)⁻¹ * f y * f y * f x * f y * f y * f x
    simp
  · show f (x⁻¹ * y * y * x * y * y * x⁻¹) = (f x)⁻¹ * f y * f y * f x * f y * f y * (f x)⁻¹
    simp
  · show f (y⁻¹ * x⁻¹ * y⁻¹ * y⁻¹ * x⁻¹ * y⁻¹ * y⁻¹) = (f y)⁻¹ * (f x)⁻¹ * (f y)⁻¹ * (f y)⁻¹ * (f x)⁻¹ * (f y)⁻¹ * (f y)⁻¹
    simp
  · show f (x * y * x * y * y * x * y * y) = f x * f y * f x * f y * f y * f x * f y * f y
    simp
  · show f (x * y * x * y⁻¹ * y⁻¹ * x⁻¹ * y⁻¹ * y⁻¹) = f x * f y * f x * (f y)⁻¹ * (f y)⁻¹ * (f x)⁻¹ * (f y)⁻¹ * (f y)⁻¹
    simp

