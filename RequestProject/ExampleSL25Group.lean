/-- The coset words are words in the two generators, so any group homomorphism carries the
`i`-th word of one pair of generators to the `i`-th word of its image pair. -/
theorem map_Wv {H : Type*} [Group H] (f : G →* H) (x y : G) (i : Fin 120) :
    f (Wv x y i) = Wv (f x) (f y) i := by
  fin_cases i
  · show f (1) = 1
    simp
  · show f (x) = f x
    simp
  · show f (y) = f y
    simp
  · show f (x⁻¹) = (f x)⁻¹
    simp
  · show f (y⁻¹) = (f y)⁻¹
    simp
  · show f (x * x) = f x * f x
    simp
  · show f (x * y) = f x * f y
    simp
  · show f (x * y⁻¹) = f x * (f y)⁻¹
    simp
  · show f (y * x) = f y * f x
    simp
  · show f (y * y) = f y * f y
    simp
  · show f (y * x⁻¹) = f y * (f x)⁻¹
