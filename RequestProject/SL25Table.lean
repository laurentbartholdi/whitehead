theorem e_5_y (hr : x * x * y * x⁻¹ * y = 1 ∧ x * y * y * y * y * x * y⁻¹ = 1) :
    (x * x) * y * (y⁻¹ * x)⁻¹ = 1 := by
  have hz : (1 : G) * (x * x * y * x⁻¹ * y) * (1 : G)⁻¹ = 1 := by
    rw [hr.1]; gid
  have key : (1 : G) * (x * x * y * x⁻¹ * y) * (1 : G)⁻¹ = (((1 : G) * x * (x)⁻¹) * ((x) * x * (x * x)⁻¹)) * ((x * x) * y * (y⁻¹ * x)⁻¹) * (((y⁻¹ * x) * x⁻¹ * (y⁻¹)⁻¹) * ((y⁻¹) * y * (1 : G)⁻¹)) := by
    gid
  rw [key] at hz
  have hP : (((1 : G) * x * (x)⁻¹) * ((x) * x * (x * x)⁻¹)) = 1 := by
    simp only [e_0_x, e_1_x]
    all_goals simp only [one_mul]
  have hQ : (((y⁻¹ * x) * x⁻¹ * (y⁻¹)⁻¹) * ((y⁻¹) * y * (1 : G)⁻¹)) = 1 := by
    simp only [flipEdge (e_4_x), e_4_y]
    all_goals simp only [one_mul]
  exact extractMid hz hP hQ

theorem e_20_y (hr : x * x * y * x⁻¹ * y = 1 ∧ x * y * y * y * y * x * y⁻¹ = 1) :
    (x * y * y) * y * (y * x⁻¹ * y⁻¹)⁻¹ = 1 := by
  have hz : (1 : G) * (x * y * y * y * y * x * y⁻¹) * (1 : G)⁻¹ = 1 := by
    rw [hr.2]; gid
  have key : (1 : G) * (x * y * y * y * y * x * y⁻¹) * (1 : G)⁻¹ = (((1 : G) * x * (x)⁻¹) * ((x) * y * (x * y)⁻¹) * ((x * y) * y * (x * y * y)⁻¹)) * ((x * y * y) * y * (y * x⁻¹ * y⁻¹)⁻¹) * (((y * x⁻¹ * y⁻¹) * y * (y * x⁻¹)⁻¹) * ((y * x⁻¹) * x * (y)⁻¹) * ((y) * y⁻¹ * (1 : G)⁻¹)) := by
    gid
  rw [key] at hz
  have hP : (((1 : G) * x * (x)⁻¹) * ((x) * y * (x * y)⁻¹) * ((x * y) * y * (x * y * y)⁻¹)) = 1 := by
    simp only [e_0_x, e_1_y]
    all_goals simp only [one_mul]
