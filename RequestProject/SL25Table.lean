import Mathlib

/-!
# Coset table for the presentation `A = ⟨x, y | x²yx⁻¹y, xy⁴xy⁻¹⟩` of Remark 2

Remark 2 of the paper quotes `G(A) ≅ SL(2,5)` for the presentation
`A = ⟨x, y | x²yx⁻¹y, xy⁴xy⁻¹⟩`.  This file carries out in Lean the coset enumeration
behind the hard half of that isomorphism.  It fixes 120 words `W₀, …, W₁₁₉` in the two
generators and proves, in *every* group generated by two elements `x, y` subject to the two
relators, the 240 table identities `Wᵢ · g = W_j` (written in the equivalent form
`Wᵢ · g · W_j⁻¹ = 1`), where `g` runs over the two generators.

Each identity is either a free cancellation — the edges of a spanning tree of the Cayley
graph, closed by `group` — or a Todd–Coxeter deduction: one of the two relators is scanned
around a closed path all of whose other edges are already known.  The deduction rests on
the telescoping identity

  `W · r · W⁻¹ = (W₀ g₁ W₁⁻¹) (W₁ g₂ W₂⁻¹) ⋯ (W_{k-1} g_k W_k⁻¹)`,

whose left-hand side is trivial because `r = 1`.

`RequestProject/ExampleSL25Group.lean` assembles these 240 identities into the
isomorphism `G(A) ≅ SL(2,5)`.
-/

namespace FiniteChains
namespace ExampleA

variable {G : Type*} [Group G] {x y : G}

/-- Normalizes an identity that holds in the free group on `x, y`. -/
macro "gid" : tactic => `(tactic| (group <;> (try norm_num [zpow_ofNat, pow_succ, mul_assoc])))

theorem flipEdge {G : Type*} [Group G] {a b g : G} (h : a * g * b⁻¹ = 1) :
    b * g⁻¹ * a⁻¹ = 1 := by
  have h' : a * g = b := mul_inv_eq_one.mp h
  rw [← h']; gid

theorem flipEdge' {G : Type*} [Group G] {a b g : G} (h : b * g⁻¹ * a⁻¹ = 1) :
    a * g * b⁻¹ = 1 := by
  have h' : b * g⁻¹ = a := mul_inv_eq_one.mp h
  rw [← h']; gid

theorem extractMid {G : Type*} [Group G] {P S Q : G} (h : P * S * Q = 1) (hP : P = 1)
    (hQ : Q = 1) : S = 1 := by
  rw [hP, hQ, one_mul, mul_one] at h; exact h

theorem extractLeft {G : Type*} [Group G] {S Q : G} (h : S * Q = 1) (hQ : Q = 1) : S = 1 := by
  rw [hQ, mul_one] at h; exact h

theorem extractRight {G : Type*} [Group G] {P S : G} (h : P * S = 1) (hP : P = 1) : S = 1 := by
  rw [hP, one_mul] at h; exact h

